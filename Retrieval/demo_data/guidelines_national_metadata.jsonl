{"section_id": "guideline_spc_spp_2021_common_factor_014", "doc_id": "guideline_spc_spp_2021", "source_level": "national", "jurisdiction": "CN", "version_group": "2021", "source_doc_version_group": "2021", "legal_snapshot": "modern_latest", "is_default_for_cail2018": false, "section_type": "common_factor", "section_order": 14, "section_heading": "（十四）对于被告人认罪认罚的,综合考虑犯罪的性质、罪行的轻重、认罪认罚的阶段、程度、价", "section_path": ["常见量刑情节的适用", "（十四）对于被告人认罪认罚的,综合考虑犯罪的性质、罪行的轻重、认罪认罚的阶段、程"], "section_text": "（十四）对于被告人认罪认罚的,综合考虑犯罪的性质、罪行的轻重、认罪认罚的阶段、程度、价\n值、悔罪表现等情况,可以减少基准刑的 30% 以下;具有自首、重大坦白、退赃退赔、赔偿谅解、刑事和\n解等情节的,可以减少基准刑的 60% 以下,犯罪较轻的,可以减少基准刑的 60% 以上或者依法免除处\n罚.认罪认罚与自首、坦白、当庭自愿认罪、退赃退赔、赔偿谅解、刑事和解、羁押期间表现好等量刑情\n节不作重复评价.", "crime_tags": [], "factor_tags": ["和解", "坦白", "当庭自愿认罪", "悔罪", "自首", "认罪", "认罪认罚", "谅解", "赔偿", "退赃", "退赔"], "rule_type_tags": ["adjust_base_sentence", "base_sentence", "compensation_and_restitution", "confession_and_surrender", "general_principle", "mitigating_adjustment"], "include_in_index": true, "source_url": "https://liangxing.swupl.edu.cn/zcfg/lxzdyj/d1f444625ff44e058b25ce596b89b9be.htm"}
